{
  "name": "aiflex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "cron": "tsx scripts/cron.ts",
    "worker": "AIFLEX_ROLE=worker tsx scripts/worker.ts",
    "preflight": "tsx scripts/preflight.ts",
    "preflight:json": "tsx scripts/preflight.ts --json",
    "preflight:ffmpeg": "bash scripts/check-ffmpeg-features.sh",
    "install:ffmpeg-full": "bash scripts/install-ffmpeg-full.sh",
    "bake:luts": "bash scripts/bake-aces-luts.sh",
    "backup:db": "bash scripts/backup-db.sh",
    "payouts:preview": "tsx scripts/payouts-preview.ts",
    "seed:bootstrap-admin": "NODE_OPTIONS=\"-r ./scripts/_noop-server-only.cjs\" tsx scripts/seed-bootstrap-admin.ts",
    "seed:pika-effects": "NODE_OPTIONS=\"-r ./scripts/_noop-server-only.cjs\" tsx scripts/seed-pika-effects.ts",
    "seed:voice-catalog": "NODE_OPTIONS=\"-r ./scripts/_noop-server-only.cjs\" tsx scripts/seed-voice-catalog.ts",
    "seed:avatar-catalog": "NODE_OPTIONS=\"-r ./scripts/_noop-server-only.cjs\" tsx scripts/seed-avatar-catalog.ts",
    "seed:wave5": "npm run seed:bootstrap-admin && npm run seed:pika-effects && npm run seed:voice-catalog && npm run seed:avatar-catalog",
    "loadtest:autocannon": "tsx scripts/load-tests/autocannon-scenarios.ts",
    "loadtest:k6:browse": "k6 run scripts/load-tests/k6/browse.js",
    "loadtest:k6:scene-gen": "k6 run scripts/load-tests/k6/scene-generation.js",
    "loadtest:k6:realtime": "k6 run scripts/load-tests/k6/realtime-avatar.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "next lint --fix --file"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@dolbyio/dolbyio-rest-apis-client": "^6.2.0",
    "@fal-ai/client": "^1.6.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.49.0",
    "@types/web-push": "^3.6.4",
    "bullmq": "^5.74.1",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.1",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "posthog-node": "^5.29.2",
    "prisma": "^5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "autocannon": "^8.0.0",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.2.10",
    "node-cron": "^3.0.3",
    "postcss": "8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "3.4.14",
    "tsx": "^4.19.0",
    "typescript": "5.6.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.4",
    "vitest-mock-extended": "^4.0.0"
  },
  "//deps-to-add-as-features-land": {
    "description": "These V7/V8 features each require an npm install when you wire them up. Deliberately kept out of dependencies so the install stays lean.",
    "stripe-billing": [
      "stripe"
    ],
    "email-resend": [
      "resend"
    ],
    "error-monitoring": [
      "@sentry/nextjs"
    ],
    "product-analytics": [
      "posthog-node",
      "posthog-js"
    ],
    "persistent-queue": [
      "bullmq",
      "ioredis"
    ],
    "pwa-push": [
      "web-push"
    ],
    "image-processing": [
      "sharp"
    ],
    "elevenlabs-voice": [
      "elevenlabs"
    ],
    "pgvector-orm": [
      "pgvector"
    ],
    "charts-analytics": [
      "recharts"
    ],
    "feature-flags": [
      "@growthbook/growthbook-react"
    ]
  }
}
