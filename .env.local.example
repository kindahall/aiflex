# ── Clés API IA ─────────────────────────────────────────────────────
# Au moins UNE des deux clés narratives est requise. L'admin choisit
# le modèle actif depuis /admin/settings.

# OpenAI — GPT-5.4 (modèle narratif par défaut)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — Claude Opus/Sonnet/Haiku (alternative narrative)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# fal.ai — Seedance, Veo, Kling, Hailuo, Luma (génération vidéo)
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=fal_...

# ── Optionnel ───────────────────────────────────────────────────────

# Hard override du modèle vidéo. Si absent, le modèle configuré par
# l'admin dans /admin/settings est utilisé.
# SEEDANCE_MODEL=fal-ai/bytedance/seedance/v2/pro/text-to-video

# Secret pour les tokens de reset password / vérification email.
# En production : >= 16 caractères aléatoires. En dev : fallback auto.
# AIFLEX_TOKEN_SECRET=un-secret-aleatoire-de-32-chars

# URL publique de l'app (pour les liens dans les emails).
# NEXT_PUBLIC_APP_URL=https://aiflex.app

# ── Admin bootstrap ────────────────────────────────────────────────
# Compte admin seedé au premier démarrage.
# Règle: ADMIN_PASSWORD doit faire ≥ 12 caractères, sinon un mot de passe
# aléatoire est généré et loggé UNE SEULE FOIS au boot (copie-le depuis stderr).
# Change-le ensuite via /admin/security.
ADMIN_EMAIL=admin@aiflex.local
# ADMIN_PASSWORD=(leave unset to auto-generate, or set ≥12 chars)

# ── Email (Resend) ─────────────────────────────────────────────────────
# Get one at https://resend.com/api-keys
# RESEND_API_KEY=re_...
# EMAIL_FROM=AIflex <noreply@aiflex.app>

# ── Error monitoring (Sentry) ─────────────────────────────────────────
# Full DSN from your Sentry project settings
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# ── Analytics (PostHog) ───────────────────────────────────────────────
# Get these from PostHog project settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── OAuth ────────────────────────────────────────────────────────────
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# GitHub OAuth (https://github.com/settings/developers)
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# Apple Sign In (https://developer.apple.com/account/resources/identifiers)
# APPLE_CLIENT_ID=com.example.aiflex
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Base URL for OAuth redirect URIs
# NEXT_PUBLIC_BASE_URL=https://aiflex.app

# ── Stripe (Paiement) ────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_PRO_ANNUAL_PRICE_ID=price_...
# STRIPE_STUDIO_PRICE_ID=price_...
# STRIPE_STUDIO_ANNUAL_PRICE_ID=price_...

# ── Push Notifications (VAPID) ───────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# ── Database (PostgreSQL via Prisma) ──────────────────────────────────
# Set DB_PROVIDER=prisma to switch from JSON to PostgreSQL
# DB_PROVIDER=json
# DATABASE_URL=postgresql://user:password@localhost:5432/aiflex

# ── Storage (S3/R2/Backblaze B2) ─────────────────────────────────────
# Works with AWS S3, Cloudflare R2, Backblaze B2 (same S3-compatible API).
# For Backblaze B2 + Cloudflare CDN (V7 §9):
#   S3_BUCKET=aiflex-videos
#   S3_REGION=us-west-004
#   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   S3_PUBLIC_URL=https://cdn.aiflex.app    ← Cloudflare CNAME in Proxy mode
# S3_BUCKET=aiflex-videos
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.aiflex.app

# ── Cron endpoints shared secret ────────────────────────────────────
# Used by /api/agent/cron-check, /api/payouts/run, and 6 other cron routes.
# Generate with: openssl rand -hex 32
# CRON_SECRET=...
#
# Optional IP allowlist (comma-separated) — REQUIRED in production.
# When set, a cron request must match BOTH the secret AND come from a listed IP.
# CRON_ALLOWED_IPS=10.0.0.5,10.0.0.6

# ── Sentry (error tracking) ─────────────────────────────────────────
# Leave unset for no-op. Server-side DSN (used by sentry.server.config.ts):
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# Client bundle DSN (public — injected into the browser):
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# For source map upload at build time (CI only):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_ENV=staging

# ── Redis / BullMQ (V8 §B7.2) ───────────────────────────────────────
# Required to replace the in-memory job-queue with a persistent one.
# REDIS_URL=redis://localhost:6379

# ── ElevenLabs (voice, dubbing — V8 §B4.7, §B10.1) ──────────────────
# ELEVENLABS_API_KEY=...

# ── Sync Labs (lip-sync — V8 §B10.2) ────────────────────────────────
# SYNC_LABS_API_KEY=...

# ── Suno (music generation — V8 §B10.3) ─────────────────────────────
# SUNO_API_KEY=...

# ── Yoti (age verification — V8 §B1.4) ──────────────────────────────
# YOTI_API_KEY=...
# YOTI_SDK_ID=...

# ── Feature flags (V8 §B7.6) ────────────────────────────────────────
# GROWTHBOOK_API_KEY=...

# ── Backups (V8 §B7.4) ──────────────────────────────────────────────
# BACKUP_GPG_RECIPIENT=backup@aiflex.com
# BACKUP_RETENTION_DAYS=30

# ── C2PA content credentials (V8 §19.3) ─────────────────────────────
# C2PA_SIGNING_CERT_PATH=/etc/aiflex/c2pa-cert.pem
# C2PA_SIGNING_KEY_PATH=/etc/aiflex/c2pa-key.pem
