// ===========================================================================
// SSO / SCIM (Wave 5.7 — enterprise identity)
// ===========================================================================

model SsoConnection {
  id           String   @id @default(cuid())
  /// Customer-chosen slug (used in metadata URL): /saml/{slug}/metadata
  slug         String   @unique
  /// "saml" | "oidc"
  kind         String   @default("saml")
  /// Display name for admin UI
  name         String
  /// Domain (for auto-routing email → IdP)
  emailDomain  String?
  /// IdP SSO entrypoint URL (SAML Redirect or OIDC authorize endpoint)
  ssoUrl       String
  /// IdP x509 certificate (PEM) for SAML signature verification, or OIDC JWKS URL
  certPem      String?
  jwksUrl      String?
  /// Audience / SP entity ID
  audience     String
  /// OIDC client id / client secret pair (null for SAML)
  oidcClientId String?
  oidcSecret   String?
  /// Enabled flag; disabled connections cannot auth
  enabled      Boolean  @default(true)
  /// SCIM provisioning: generated bearer token (sha256-hashed for storage)
  scimTokenHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([emailDomain])
  @@index([enabled])
}

// ===========================================================================
// API USAGE TRACKING (V8 §25.8)
// ===========================================================================

// ===========================================================================
// DOLBY.IO ASYNC TRANSCODE JOBS (Wave 11.7 — webhook-driven Atmos)
// ===========================================================================
//
// Background ingest of Dolby.io Media API jobs. The compose pipeline
// submits a job with `callback_url` pointing to /api/webhooks/dolbyio
// and creates a row here keyed on the returned `jobId`. When the webhook
// arrives, we verify the HMAC signature, update the row's status, and
// kick off a download-and-persist worker for Succeeded jobs.

model DolbyIOJob {
  id          String   @id @default(cuid())
  /// Dolby.io job_id returned by POST /v1/media/transcode. Unique per
  /// account, so we use it as the idempotency key for the webhook path.
  jobId       String   @unique
  projectId   String
  /// Project owner — denormalised so the download worker can notify
  /// without an extra join.
  ownerId     String
  /// "pending" | "running" | "succeeded" | "failed"
  status      String   @default("pending")
  /// Dolby.io-presigned URL for the transcoded output, populated by the
  /// webhook. The download worker fetches this into our own storage so
  /// we don't depend on the ~24h presigned window.
  resultUrl   String?
  /// Short error string when status = "failed" (for ops visibility).
  errorText   String?
  /// "dlb://" storage key of the output in Dolby.io temporary storage.
  /// Needed to re-download via SDK if the presigned URL expired.
  outputDlb   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([ownerId])
  @@index([status])
}

model DailyApiUsage {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime // UTC midnight of the day
  // Counters — each lib bumps its own column at call time
  claudeTokens    Int      @default(0)
  openaiTokens    Int      @default(0)
  fluxImages      Int      @default(0)
  seedanceSeconds Int      @default(0)
  whisperMinutes  Int      @default(0)
  elevenLabsChars Int      @default(0)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
