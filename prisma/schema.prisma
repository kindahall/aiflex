// ===========================================================================
// ACT ONE FACE CAPTURE (Wave 5.6 — Runway Act One facial capture)
// ===========================================================================

model FaceCaptureTrack {
  id          String   @id @default(cuid())
  ownerId     String
  projectId   String?
  sceneId     String?
  /// Mediapipe FaceLandmarker blendshape track (Float32 per frame) stored as blob URL
  trackUrl    String
  /// Sample rate in Hz (usually 30 or 60)
  sampleRate  Int      @default(30)
  /// Duration of the capture in milliseconds
  durationMs  Int
  /// Optional reference image of the driving actor (for preview)
  previewUrl  String?
  createdAt   DateTime @default(now())

