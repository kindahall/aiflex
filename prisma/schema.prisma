// ===========================================================================
// BRAND KIT (Wave 5.1 — HeyGen-style brand consistency for B2B)
// ===========================================================================

model BrandKit {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  /// Hex palette stored as JSON: { primary, secondary, accent, neutral, background, text }
  palette     Json
  /// Typography config: { displayFont, bodyFont, headingWeight, bodyWeight }
  typography  Json
  /// Voice/tone guidance injected into narrative prompts (adjectives, do/don't lists)
  tone        Json?
  /// Logo + watermark + brand element URLs, stored as array
  assets      BrandKitAsset[]
  /// Optional default tagline to inject into outro templates
  tagline     String?
  /// Default watermark position (tl, tr, bl, br, none)
  watermarkPos String  @default("br")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model BrandKitAsset {
  id         String   @id @default(cuid())
  brandKitId String
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  kind       String   // "logo_primary" | "logo_reverse" | "watermark" | "background" | "element" | "font"
  url        String
  alt        String?
  createdAt  DateTime @default(now())

  @@index([brandKitId])
}

// ===========================================================================
// PIKA EFFECTS CATALOG (Wave 5.2 — 15 parametric visual effects)
// ===========================================================================

model PikaEffect {
  id               String   @id @default(cuid())
  /// Stable slug used in UI + prompt router (e.g. "explode", "cake-ify", "squish")
  slug             String   @unique
  label            String
  description      String
  /// Prompt template with `{{subject}}` substitution hook
  promptTemplate   String
  /// Optional negative prompt template
  negativePrompt   String?
  /// Which providers this effect is tuned for; others fall back to prompt-only
  providers        String[] @default([])
  /// Reference ControlNet mode if the provider supports it ("softedge" | "canny" | "depth" | "pose" | null)
  controlNet       String?
  /// Duration hint in seconds for the generator
  defaultDuration  Int      @default(4)
  /// User-facing preview clip stored in S3/R2
  previewUrl       String?
  /// Category for grouping in picker ("motion" | "transform" | "destruction" | "material" | "camera")
  category         String   @default("motion")
  /// Whether users on free plan can use this effect
  isFree           Boolean  @default(true)
  /// Sorting weight in the UI
  weight           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([isFree])
}

// ===========================================================================
// VOICE CATALOG (Wave 5.3 — 400+ prebuilt voices a la HeyGen)
// ===========================================================================

model VoiceProfile {
  id           String   @id @default(cuid())
  /// Provider id (e.g. ElevenLabs voice_id or OpenAI TTS voice name)
  providerId   String
  provider     String   // "elevenlabs" | "openai" | "playht" | "resemble"
  name         String
  language     String   @default("fr")
  gender       String   @default("neutral") // "male" | "female" | "neutral"
  /// Comma-free tags: "young", "deep", "warm", "narrator", "news-anchor"
  tags         String[] @default([])
  previewUrl   String?
  /// Whether admin has promoted this to the public catalog
  isPublic     Boolean  @default(true)
  isOfficial   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([language])
  @@index([isPublic])
  @@index([isOfficial])
}

// ===========================================================================
// MODEL BENCH (Wave 5.4 — run the same prompt across N models + compare)
// ===========================================================================

model ModelBenchRun {
  id          String            @id @default(cuid())
  ownerId     String
  name        String
  prompt      String
  /// Optional reference image URL to use consistently across all models
  imageUrl    String?
  durationSec Int               @default(5)
  aspectRatio String            @default("16:9")
  resolution  String            @default("720p")
  status      String            @default("pending") // "pending" | "running" | "done" | "error"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  results     BenchRunResult[]

  @@index([ownerId])
  @@index([status])
}

model BenchRunResult {
  id              String        @id @default(cuid())
  benchRunId      String
  benchRun        ModelBenchRun @relation(fields: [benchRunId], references: [id], onDelete: Cascade)
  /// Full provider model id (e.g. "fal-ai/bytedance/seedance/v2/pro/text-to-video")
  modelId         String
  status          String        @default("pending") // "pending" | "running" | "done" | "error"
  videoUrl        String?
  errorMessage    String?
  /// Latency in ms between submit and completion
  latencyMs       Int?
  /// Actual cost billed for this generation (in microUSD)
  costMicroUsd    Int?
  /// User-submitted rating 1..5 (null until voted)
  rating          Int?
  /// Optional comment from the rater
  comment         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([benchRunId, modelId])
  @@index([benchRunId])
  @@index([modelId])
}

